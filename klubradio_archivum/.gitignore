# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
tmp/*

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing
android/key.properties
*.jks
*.keystore

.gemini/settings.json

# Local env / deploy secrets (never commit)
.env
.env.deploy
supabase/.temp/

# Agent coordination outputs (ephemeral, not committed)
docs/agent-outputs/*
!docs/agent-outputs/README.md
!docs/agent-outputs/TEMPLATE-*.md
!docs/agent-outputs/EXAMPLE-*.md
# Keep old template backups local only
docs/agent-outputs/*.bak
